<%= turbo_frame_tag "btu-result" do %>
  <div class="max-w-md mx-auto bg-white shadow-md rounded px-8 pt-6 pb-8 mb-4">
    <h2 class="text-2xl font-bold mb-4 text-center">Result</h2>
    <p class="mb-4">
      <span class="font-semibold">Required BTU:</span>
      <span class="text-lg text-indigo-600"><%= number_with_delimiter(@btu) %> BTU</span>
    </p>
    <p class="text-sm text-gray-600">
      This is an estimate based on the provided information. Consult with a professional for more accurate calculations.
    </p>
  </div>
<% end %>
